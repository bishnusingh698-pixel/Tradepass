# Copy to .env for local development. On Render, set these in the service's
# Environment tab instead (never commit real values).

# From Partner Dashboard → Apps → Tradepass → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL of the app (Render URL in production; the CLI sets it in dev)
SHOPIFY_APP_URL=https://tradepass.onrender.com
SCOPES=write_companies,write_customers,write_markets,write_products,write_publications,write_files,write_validations,read_orders,read_locales

# Neon Postgres. Pooled connection string (host contains "-pooler") for the app,
# direct connection string for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts tax numbers. Never rotate without a migration.
ENCRYPTION_KEY=
# Any long random string: `openssl rand -hex 32`. Signs "more info" / renewal links.
LINK_TOKEN_SECRET=
# Any long random string. cron-job.org sends it as the X-Tradepass-Job-Secret header.
JOB_SECRET=

# Brevo (email).
BREVO_API_KEY=
# Verified sender address in Brevo (Senders & IP). Sender name is the store name; replies go to the store's email.
BREVO_SENDER_EMAIL=
# Set to true on a staging app so plan charges are test charges.
BILLING_TEST=false

SUPPORT_EMAIL=

# Optional free tax-number registries (Starter plan and up). Leave empty to skip:
# numbers are still stored and shown as "Couldn't check". See README → Environment.
# HMRC Developer Hub app subscribed to "Check a UK VAT number".
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Free ABN Lookup web services GUID.
ABN_GUID=
