{%- comment -%}
  "Wholesale application form" app block. The form definition and merchant texts come
  from app-data metafields (tradepass.forms / tradepass.texts); built-in strings come
  from this extension's locale files. Only submission and file upload reach our server
  (through the app proxy, /apps/tradepass/...).
{%- endcomment -%}
{%- liquid
  assign tp_forms = app.metafields.tradepass.forms.value
  assign tp_fid = block.settings.form_id | strip
  if tp_fid == blank
    assign tp_fid = tp_forms.default
  endif
  assign tp_form = tp_forms.forms[tp_fid]
  if tp_form == blank
    assign tp_fid = tp_forms.default
    assign tp_form = tp_forms.forms[tp_fid]
  endif
  assign tp_locale = request.locale.iso_code
  assign tp_base = tp_locale | split: '-' | first
  assign tp_rtl_list = 'ar|he|ur|fa' | split: '|'
  assign tp_dir = 'ltr'
  if tp_rtl_list contains tp_base
    assign tp_dir = 'rtl'
  endif
  assign tp_over = app.metafields.tradepass.texts.value[tp_locale]
  assign tp_heading = block.settings.heading | default: tp_over['form.heading']
  if tp_heading == blank
    assign tp_heading = 'form.heading' | t
  endif
  assign tp_intro = tp_over['form.intro']
  if tp_intro == blank
    assign tp_intro = 'form.intro' | t
  endif
-%}
<div class="tradepass-form page-width" data-tradepass-form dir="{{ tp_dir }}" lang="{{ tp_locale }}" {{ block.shopify_attributes }}>
  {%- if block.settings.show_heading -%}
    <h2 class="tradepass-form__heading">{{ tp_heading | escape }}</h2>
    <p class="tradepass-form__intro">{{ tp_intro | escape }}</p>
  {%- endif -%}
  <div class="tpf-mount">
    {%- if tp_form == blank -%}
      <p>{{ 'form.unavailable' | t }}</p>
    {%- endif -%}
  </div>
  {%- comment -%} Free plan only: config.brand is the link URL, null on paid plans. {%- endcomment -%}
  {%- assign tp_brand = app.metafields.tradepass.config.value.brand -%}
  {%- if tp_form != blank and tp_brand != blank -%}
    <p class="tradepass-form__brand"><a href="{{ tp_brand | escape }}" target="_blank" rel="noopener">{{ 'brand.powered_by' | t }}</a></p>
  {%- endif -%}
  {%- if tp_form != blank -%}
  <script type="application/json">
    {
      "definition": {{ tp_form.def | json }},
      "formId": {{ tp_fid | json }},
      "locale": {{ tp_locale | json }},
      "dir": {{ tp_dir | json }},
      "endpoint": "/apps/tradepass",
      "country": {{ localization.country.iso_code | json }},
      "countriesUrl": {{ 'tradepass-countries.json' | asset_url | json }},
      "prefill": {% if customer %}{ "firstName": {{ customer.first_name | json }}, "lastName": {{ customer.last_name | json }}, "email": {{ customer.email | json }} }{% else %}null{% endif %},
      "languages": [{% for l in localization.available_languages %}{ "code": {{ l.iso_code | json }}, "name": {{ l.endonym_name | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}],
      "overrides": {{ tp_over | json }},
      "texts": {% render 'tradepass-form-texts' %}
    }
  </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:form_block.name",
  "target": "section",
  "javascript": "tradepass-form.js",
  "stylesheet": "tradepass-form.css",
  "settings": [
    { "type": "text", "id": "form_id", "label": "t:form_block.form_id", "info": "t:form_block.form_id_info" },
    { "type": "checkbox", "id": "show_heading", "label": "t:form_block.show_heading", "default": true },
    { "type": "text", "id": "heading", "label": "t:form_block.heading", "info": "t:form_block.heading_info" }
  ]
}
{% endschema %}
